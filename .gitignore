# runtime world state — regenerated by any run, and large
state/
chronicle/
interventions/*.json
interventions/failed/*
# interventions/done/ IS tracked: it is the game-master's actual decisions and its
# reasoning for them, which is the most interesting writing this world produces and
# comes to only ~150 KB. The raw Chronicle stays out (24 MB, 99% weather) -- run
# tools/worldlog.py to refresh WORLD-LOG.md, which is the readable digest of it.

# stdout/stderr captured from a running sim
logs/

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# editors / os
.vscode/
.idea/
Thumbs.db
desktop.ini
!interventions/done/.gitkeep
!interventions/failed/.gitkeep

# local machine settings, not project config
.claude/settings.local.json
.claude/settings.local.json.bak
