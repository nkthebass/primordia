# runtime world state — regenerated by any run, and large
state/
chronicle/
interventions/done/*
interventions/failed/*
interventions/*.json

# stdout/stderr captured from a running sim
logs/

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# editors / os
.vscode/
.idea/
Thumbs.db
desktop.ini
!interventions/done/.gitkeep
!interventions/failed/.gitkeep

# local machine settings, not project config
.claude/settings.local.json
.claude/settings.local.json.bak
